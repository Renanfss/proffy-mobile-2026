<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.forgot.ForgotPasswordActivity"
    tools:theme="@style/Theme.MaterialComponents.Light.NoActionBar">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <RelativeLayout
            android:id="@+id/containerBackgroundForgot"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="@color/purple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageBackgroundForgot"
                android:layout_width="238dp"
                android:layout_height="266dp"
                android:layout_centerInParent="true"
                android:contentDescription="@string/content_description_header_bg"
                android:src="@drawable/background_2" />

            <ImageView
                android:id="@+id/imageIntroForgot"
                android:layout_width="160dp"
                android:layout_height="80dp"
                android:layout_centerInParent="true"
                android:contentDescription="@string/content_description_logo"
                android:src="@drawable/intro" />
        </RelativeLayout>

        <ImageButton
            android:id="@+id/buttonGoBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:background="@null"
            android:contentDescription="@string/content_description_back"
            android:src="@drawable/ic_arrow_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/containerBackgroundForgot" />

        <TextView
            android:id="@+id/textViewTitleForgot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/forgot_password_title"
            android:textColor="@color/text_title"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonGoBack" />

        <TextView
            android:id="@+id/textViewSubtitleForgot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="4dp"
            android:text="@string/forgot_password_subtitle"
            android:textColor="@color/text_base"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewTitleForgot" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutEmail"
            style="@style/CustomFilledTextFieldEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="32dp"
            android:hint="@string/hint_email"
            app:boxStrokeErrorColor="@color/delete"
            app:errorIconTint="@color/delete"
            app:errorTextColor="@color/delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewSubtitleForgot">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textInputEditEmail"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:inputType="textEmailAddress"
                android:textAppearance="@font/poppins"
                android:textColor="@color/text_base"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/buttonSend"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/shape_disable"
            android:elevation="0dp"
            android:enabled="false"
            android:fontFamily="@font/poppins_semibold"
            android:stateListAnimator="@null"
            android:text="@string/button_enter"
            android:textAllCaps="false"
            android:textColor="@color/text_complement"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textInputLayoutEmail" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>